{
  "name": "cleancut",
  "version": "0.1.0",
  "private": true,
  "description": "Watch any show at the rating you choose: a browser extension that skips, mutes or hides explicit scenes on Netflix, Prime Video, YouTube, Disney+, Max, Hulu and other streaming sites, using a community catalog of timestamped tags kept on GitHub.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "cleancut-scan": "scanner/src/cli.js"
  },
  "scripts": {
    "build": "node extension/build.mjs",
    "watch": "node extension/build.mjs --watch",
    "package": "CLEANCUT_STORE=1 npm run build && cd extension/dist/chrome && rm -f ../cleancut-chrome.zip && zip -qr ../cleancut-chrome.zip . && echo Wrote extension/dist/cleancut-chrome.zip",
    "dev": "node scripts/dev-server.mjs",
    "catalog": "node scripts/catalog.mjs",
    "scan": "node scanner/src/cli.js",
    "demo:video": "sh scripts/make-demo-video.sh",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "test:e2e": "npm run build && node --disable-warning=ExperimentalWarning test/e2e/extension.e2e.mjs",
    "test:e2e:youtube": "npm run build && node --disable-warning=ExperimentalWarning test/e2e/youtube.e2e.mjs",
    "test:adapters": "node --disable-warning=ExperimentalWarning test/e2e/adapters.e2e.mjs",
    "test:live:youtube": "npm run build && node --disable-warning=ExperimentalWarning test/live/youtube.mjs",
    "test:live:vimeo": "npm run build && node --disable-warning=ExperimentalWarning test/live/vimeo.mjs",
    "bench": "npm run build && node --disable-warning=ExperimentalWarning test/perf/netflix-sim.mjs",
    "bench:playback": "npm run build && node --disable-warning=ExperimentalWarning test/perf/playback-sim.mjs",
    "bench:real": "npm run build && node --disable-warning=ExperimentalWarning test/perf/netflix-real.mjs",
    "setup:browser": "playwright install chromium",
    "trace": "node test/perf/analyze-trace.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "esbuild": "^0.25.0",
    "kokoro-js": "1.2.1",
    "playwright": "1.63.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.31.1"
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-node": "$onnxruntime-node"
    }
  }
}
