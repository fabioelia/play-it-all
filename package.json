{
  "name": "cleancut",
  "version": "0.1.0",
  "private": true,
  "description": "Watch any show at the rating you choose: a browser extension that skips, mutes or hides explicit scenes on Netflix and Prime Video, using a community catalog of timestamped tags kept on GitHub.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "cleancut-scan": "scanner/src/cli.js"
  },
  "scripts": {
    "build": "node extension/build.mjs",
    "watch": "node extension/build.mjs --watch",
    "dev": "node scripts/dev-server.mjs",
    "catalog": "node scripts/catalog.mjs",
    "scan": "node scanner/src/cli.js",
    "demo:video": "sh scripts/make-demo-video.sh",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "test:e2e": "npm run build && node --disable-warning=ExperimentalWarning test/e2e/extension.e2e.mjs",
    "bench": "npm run build && node --disable-warning=ExperimentalWarning test/perf/netflix-sim.mjs",
    "bench:playback": "npm run build && node --disable-warning=ExperimentalWarning test/perf/playback-sim.mjs",
    "setup:browser": "playwright install chromium",
    "trace": "node test/perf/analyze-trace.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "1.63.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.31.1"
  }
}
